# Copia a .env y rellena (FastAPI / Railway). Streamlit Cloud usa su panel Secrets.
GROQ_API_KEY=
TURSO_URL=
TURSO_TOKEN=
SESSION_SECRET=change-me-long-random
APP_URL=http://127.0.0.1:8000
STRIPE_SECRET_KEY=
