# Copia a .env y rellena (FastAPI / Railway).
GROQ_API_KEY=
# Opcional (default: openai/gpt-oss-120b; llama-3.3-70b-versatile ya no existe en Groq free/dev)
# GROQ_MODEL=openai/gpt-oss-120b
# Visión OCR recibos (default: qwen/qwen3.6-27b — Scout ya no existe en Groq free/dev)
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Opcional: scraper Súper Selectos (Fase 3 experimental)
# SELECTOS_STORE_BASE=https://www.superselectos.com
# SELECTOS_FALLBACK_BASE=https://selectospp.bitworks.com.sv
# SELECTOS_CATEGORIES=012,03
# Walmart SV / Despensa (VTEX) — limitar páginas en pruebas
# VTEX_MAX_PAGES=2
# WALMART_SV_BASE=https://www.walmart.com.sv
# DESPENSA_BASE=https://www.ladespensadedonjuan.com.sv

TURSO_URL=
TURSO_TOKEN=
SESSION_SECRET=change-me-long-random
APP_URL=http://127.0.0.1:8000
MISSION_WEB=1
# MISSION_HTTPS=1
# MISSION_ALLOW_SQLITE=1

# Cobros — preferido: Lemon Squeezy (MoR; útil si Stripe no acepta tu país)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_PREMIUM=
LEMON_SQUEEZY_VARIANT_FAMILIA=
# Opcional: buy links estáticos si no usas API checkout
# LEMON_SQUEEZY_CHECKOUT_PREMIUM=
# LEMON_SQUEEZY_CHECKOUT_FAMILIA=
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Webhook URL: https://TU-DOMINIO/lemon/webhook
# Eventos: subscription_created, subscription_updated, subscription_cancelled,
#          subscription_expired, subscription_resumed, subscription_paused,
#          subscription_unpaused, subscription_payment_success

# Alternativa: Stripe (si ya tienes cuenta operativa)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_FAMILIA=

# Google Fit / Calendar (OAuth web — cliente tipo "Aplicación web")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Debe coincidir EXACTO en Google Cloud Console → URIs de redirección
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/google/callback
OAUTH_STATE_SECRET=

# Biblioteca de ejercicios (video de galería + coach IA)
# Proveedor multimodal: groq | openai | anthropic
EXERCISE_AI_PROVIDER=groq
# EXERCISE_AI_MODEL=qwen/qwen3.6-27b
# STT: groq | openai | none
EXERCISE_STT_PROVIDER=groq
# EXERCISE_STT_MODEL=whisper-large-v3
EXERCISE_VIDEO_MAX_MB=100
EXERCISE_VIDEO_MAX_SECONDS=60
EXERCISE_VIDEO_HARD_MAX_SECONDS=90
# EXERCISE_STORAGE_DIR=
# Opcional: binario ffmpeg si no está en PATH (Railway lo instala vía nixpacks.toml)
# FFMPEG_PATH=
# FFPROBE_PATH=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
