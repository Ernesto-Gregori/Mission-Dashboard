# Copia a .env y rellena (FastAPI / Railway). Streamlit Cloud usaba su panel Secrets.
GROQ_API_KEY=
TURSO_URL=
TURSO_TOKEN=
SESSION_SECRET=change-me-long-random
APP_URL=http://127.0.0.1:8000
MISSION_WEB=1
# MISSION_HTTPS=1
# MISSION_ALLOW_SQLITE=1

# Cobros — preferido: Lemon Squeezy (MoR; útil si Stripe no acepta tu país)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_PREMIUM=
LEMON_SQUEEZY_VARIANT_FAMILIA=
# Opcional: buy links estáticos si no usas API checkout
# LEMON_SQUEEZY_CHECKOUT_PREMIUM=
# LEMON_SQUEEZY_CHECKOUT_FAMILIA=
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Webhook URL: https://TU-DOMINIO/lemon/webhook
# Eventos: subscription_created, subscription_updated, subscription_cancelled,
#          subscription_expired, subscription_resumed, subscription_paused,
#          subscription_unpaused, subscription_payment_success

# Alternativa: Stripe (si ya tienes cuenta operativa)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_FAMILIA=

# Google Fit / Calendar (OAuth web — cliente tipo "Aplicación web")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Debe coincidir EXACTO en Google Cloud Console → URIs de redirección
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/google/callback
OAUTH_STATE_SECRET=
