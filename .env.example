# Copia a .env y rellena (FastAPI / Railway). Streamlit Cloud usaba su panel Secrets.
GROQ_API_KEY=
# Opcional: modelo vision para OCR de recibos (default qwen/qwen3.6-27b)
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
TURSO_URL=
TURSO_TOKEN=
SESSION_SECRET=change-me-long-random
APP_URL=http://127.0.0.1:8000
MISSION_WEB=1
# MISSION_HTTPS=1
# MISSION_ALLOW_SQLITE=1

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_FAMILIA=

# Google Fit / Calendar (OAuth web — cliente tipo "Aplicación web")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Debe coincidir EXACTO en Google Cloud Console → URIs de redirección
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/google/callback
OAUTH_STATE_SECRET=
